{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VM Guave",
  "version": "0.3.0",
  "identifier": "dev.marloon.vmguave",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VM Guave",
        "width": 1000,
        "height": 660,
        "minWidth": 780,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Gerenciador de máquinas virtuais",
    "longDescription": "Cria e executa máquinas virtuais Linux e Windows usando QEMU, com aceleração KVM no Linux e WHPX no Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["qemu-system-x86", "qemu-utils", "ovmf"]
      },
      "rpm": {
        "depends": ["qemu-system-x86", "qemu-img", "edk2-ovmf"]
      }
    },
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"]
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  }
}
